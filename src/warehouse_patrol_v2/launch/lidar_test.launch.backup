<launch>
  <param name="/use_sim_time" value="true"/>

  <include file="$(find gazebo_ros)/launch/empty_world.launch">
    <arg name="world_name"
         value="$(find warehouse_patrol_v2)/worlds/complex_warehouse.world"/>
    <arg name="paused" value="false"/>
    <arg name="gui" value="true"/>
  </include>

  <param name="robot_description"
         command="$(find xacro)/xacro
         '$(find warehouse_patrol_v2)/urdf/lidar_sensor.xacro'"/>

  <node pkg="robot_state_publisher" type="robot_state_publisher"
        name="lidar_state_publisher"/>

  <node pkg="gazebo_ros" type="spawn_model" name="spawn_lidar_test_robot"
        args="-urdf -param robot_description -model lidar_test_robot
              -x -7 -y 0 -z 0.02" output="screen"/>

  <node pkg="rviz" type="rviz" name="lidar_rviz"
        args="-d $(find warehouse_patrol_v2)/rviz/lidar.rviz"/>
</launch>
